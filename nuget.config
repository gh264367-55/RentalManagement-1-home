<?xml version="1.0" encoding="utf-8"?>
<!-- Restore from nuget.org only, so machine-wide private feeds (with their credentials) never affect this build. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
