@model RegisterViewModel
@* View: Account/Register. Sign-up form where the user chooses to be an applicant or a property manager. *@
@{
    ViewData["Title"] = "Sign up";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h3 mb-3">Sign up</h1>
        <form asp-action="Register" method="post" class="card card-body shadow-sm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <fieldset class="mb-3">
                <legend class="form-label fs-6">@Html.DisplayNameFor(m => m.Role)</legend>
                <div class="btn-group w-100" role="group">
                    <input type="radio" class="btn-check" asp-for="Role" value="@Roles.Applicant" id="role-applicant" />
                    <label class="btn btn-outline-primary" for="role-applicant">An applicant looking for a home</label>
                    <input type="radio" class="btn-check" asp-for="Role" value="@Roles.PropertyManager" id="role-manager" />
                    <label class="btn btn-outline-primary" for="role-manager">A property manager</label>
                </div>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </fieldset>

            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <div class="form-text mt-1">At least 8 characters, with an uppercase letter, a lowercase letter, a digit and a symbol.</div>
            </div>
            <button type="submit" class="btn btn-primary w-100">Create account</button>
        </form>
        <p class="mt-3 text-center">Already have an account? <a asp-action="Login">Log in</a></p>
    </div>
</div>
