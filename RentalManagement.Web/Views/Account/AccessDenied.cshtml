@* View: Account/AccessDenied. Shown when a signed-in user opens a page their role may not use. *@
@{
    ViewData["Title"] = "Access denied";
}

<div class="py-5 text-center">
    <h1 class="h3">Access denied</h1>
    <p class="text-muted">Your account doesn't have permission to open that page.</p>
    <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">Go to the home page</a>
</div>
