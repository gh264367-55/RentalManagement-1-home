@model PropertyUnitsModel
@* View component template: PropertyUnits. A property's units table (type with inactive badge, bedrooms, rent,
   today's lease status, application count) with edit/remove buttons, and a footer count. *@

@if (Model.Units.Count == 0)
{
    <div class="card-body text-muted">No units yet. Use <strong>Add unit</strong> to create one.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    @* On phones the secondary columns are hidden and their values shown under the unit number,
                       so the table fits the screen instead of making the page scroll sideways. *@
                    <th scope="col">Unit</th>
                    <th scope="col" class="d-none d-sm-table-cell">Type</th>
                    <th scope="col" class="d-none d-md-table-cell">Bedrooms</th>
                    <th scope="col" class="text-end">Rent</th>
                    <th scope="col">Today</th>
                    <th scope="col" class="text-end d-none d-lg-table-cell">Applications</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var unit in Model.Units)
                {
                    <tr>
                        <td>
                            <span class="fw-semibold">@unit.UnitNumber</span>
                            <div class="small text-muted d-sm-none">
                                @unit.UnitTypeName@(unit.UnitTypeIsActive ? "" : " (inactive)") · @DisplayFormat.Bedrooms(unit.Bedrooms)
                            </div>
                        </td>
                        <td class="d-none d-sm-table-cell">
                            @unit.UnitTypeName
                            @if (!unit.UnitTypeIsActive)
                            {
                                <span class="badge text-bg-warning ms-1" title="This type can no longer be chosen for other units">inactive</span>
                            }
                        </td>
                        <td class="d-none d-md-table-cell">@DisplayFormat.Bedrooms(unit.Bedrooms)</td>
                        <td class="text-end">@unit.MonthlyRent.ToString("C")</td>
                        <td>
                            @if (unit.LeasedUntil is { } until)
                            {
                                <span class="badge text-bg-secondary text-wrap">Leased until @until.ToString("MMM d, yyyy")</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">Available</span>
                            }
                        </td>
                        <td class="text-end d-none d-lg-table-cell">@unit.ApplicationCount</td>
                        <td class="text-end">
                            <div class="d-flex flex-column flex-sm-row gap-1 justify-content-end">
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-modal-url="@Url.Action("Edit", "Units", new { id = unit.Id })">Edit</button>
                            @if (unit.CanDelete)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        data-modal-url="@Url.Action("Delete", "Units", new { id = unit.Id })">Remove</button>
                            }
                            else
                            {
                                <span class="d-inline-block" tabindex="0" title="This unit has applications or leases">
                                    <button type="button" class="btn btn-sm btn-outline-danger w-100" disabled>Remove</button>
                                </span>
                            }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
<div class="card-footer bg-body small text-muted">
    @Model.Units.Count @(Model.Units.Count == 1 ? "unit" : "units") · @Model.LeasedCount leased today
</div>
