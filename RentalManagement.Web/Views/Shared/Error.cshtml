@model ErrorViewModel
@* View: Shared/Error. The friendly error page shown outside Development when an unhandled exception occurs. It
   shows no exception details, only the request id so support can find the failure in the logs. *@
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="py-5 text-center">
    <h1 class="h3">Something went wrong</h1>
    <p class="text-muted">We couldn't complete your request. Please try again in a moment.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">Go to the home page</a>
</div>
